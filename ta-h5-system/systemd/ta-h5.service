[Unit]
Description=TradingAgents H5 System (FastAPI + SQLite + Hermes bridge)
After=network.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# 用项目自己的 venv（避免污染 TradingAgents venv 的 pydantic 等版本）
ExecStart=/home/lzero/workspace/TradingAgents/ta-h5-system/.venv-demo/bin/python /home/lzero/workspace/TradingAgents/ta-h5-system/server.py
WorkingDirectory=/home/lzero/workspace/TradingAgents/ta-h5-system
Restart=on-failure
RestartSec=5s

# ⚠️ TradingAgents cron 启动时会 source ~/proxy.sh + .env。H5 server 自己不跑分析，
# 但 server 调 yfinance 时也得走 proxy，所以 PATH/HOME 必须保留。
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/lzero
Environment=TA_H5_HOST=127.0.0.1
Environment=TA_H5_PORT=8765
# ⚠️ 可选鉴权（默认 off，因为只 listen 127.0.0.1，靠 Tailscale/防火墙兜底）
# Environment=TA_H5_TOKEN=换成你的密码

StandardOutput=append:/home/lzero/workspace/TradingAgents/ta-h5-system/data/server.log
StandardError=append:/home/lzero/workspace/TradingAgents/ta-h5-system/data/server.log

[Install]
WantedBy=default.target
